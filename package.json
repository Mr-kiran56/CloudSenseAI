{
  "name": "cloudsenseai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"python backend/run.py\" \"vite --host 0.0.0.0 --port 5173\"",
    "dev:all": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"python backend/run.py\" \"vite --host 0.0.0.0 --port 5173\"",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "backend": "python backend/run.py",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed": "python backend/app/db/init_db.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
