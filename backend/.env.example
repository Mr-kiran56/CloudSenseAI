# CloudSense AI Environment Configuration

PROJECT_NAME=CloudSense AI Platform
VERSION=1.0.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=cloudsense-super-secret-jwt-key-2026-production-finops-token
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For SQLite (default):
DATABASE_URL=sqlite:///./cloudsense.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudsense_db

# AWS Integration & Least-Privilege IAM
AWS_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/CloudSenseReadOnlyRole
REMEDIATION_ENABLED=false

# ML Artifacts Directory
ARTIFACTS_DIR=artifacts
